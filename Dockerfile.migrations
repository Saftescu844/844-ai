FROM node:22.17.0-alpine
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --include=dev
COPY tsconfig.json ./
COPY src ./src
COPY scripts/security ./scripts/security
ENV NODE_ENV=production
ENV PAYLOAD_DB_PUSH=false
RUN chown -R node:node /app
USER node
# No HTTP server, Next build, cron or automatically approved migration execution.
CMD ["node", "--import", "tsx", "scripts/security/run-staging-migrations.mjs"]
